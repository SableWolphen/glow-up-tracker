<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/plushlife_widget_background">

    <TextView
        android:id="@+id/widget_day_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textAllCaps="true"
        android:textColor="#A65DC1"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_next_task"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Open PlushLife for one caring step"
        android:textColor="#5B4B6B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progress="0"
        android:progressTint="#A65DC1"
        android:progressBackgroundTint="#EADCF0" />
</LinearLayout>
